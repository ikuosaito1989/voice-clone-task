{
  "name": "Kaggle cookie refresh",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop — Kaggle login",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install playwright==1.58.0 && python -m playwright install --with-deps chromium",
  "remoteEnv": { "DISPLAY": ":1" }
}
